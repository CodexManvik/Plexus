# App Configurations
APP_ENV=development
APP_SECRET_KEY=9a15b3e1074e0d9b4f9c8f2a1b3d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d

# Oracle Database 23ai Connections
# Use either DSN directly or Host/Port/Service details
ORACLE_DB_USER=system
ORACLE_DB_PASSWORD=your_secure_password
ORACLE_DB_DSN=localhost:1521/FREEPDB1
ORACLE_DB_HOST=localhost
ORACLE_DB_PORT=1521
ORACLE_DB_SERVICE_NAME=FREEPDB1

# LLM provider configuration
# Set LLM_PROVIDER=google to use Google AI Studio or LLM_PROVIDER=azure to keep Azure OpenAI.
# The default auto mode prefers Google when its key is present, then falls back to Azure.
LLM_PROVIDER=auto

# Azure OpenAI Services Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Google AI Studio / Gemini Configuration
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here
GOOGLE_AI_STUDIO_MODEL=gemini-1.5-flash

# Sentence Transformer Configuration
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
