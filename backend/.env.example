# App Configurations
APP_ENV=development
APP_SECRET_KEY=9a15b3e1074e0d9b4f9c8f2a1b3d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d

# Oracle Database 26ai Connections
# Use either DSN directly or Host/Port/Service details
ORACLE_DB_USER=system
ORACLE_DB_PASSWORD=your_secure_password
ORACLE_DB_DSN=localhost:1521/FREEPDB1
ORACLE_DB_HOST=localhost
ORACLE_DB_PORT=1521
ORACLE_DB_SERVICE_NAME=FREEPDB1

# Sentence Transformer Configuration
# Use a SentenceTransformers model id, a local model directory, or a local GGUF file.
# If you use a GGUF embedding model, set EMBEDDING_VECTOR_DIM to match its output size.
EMBEDDING_VECTOR_DIM=1024
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Cohere Configuration
COHERE_API_KEY=your_cohere_api_key_here
# COHERE_MODEL is used for contract classification. COHERE_EXTRACTION_MODEL is used for per-parameter extraction (can be a faster/cheaper model).
COHERE_MODEL=command-r-plus
COHERE_EXTRACTION_MODEL=command-r-plus

# Parsing Engine Configuration
# Set to true to use deep-learning visual PDF parsing via marker-pdf (CPU mode).
# Defaults to false (falls back to native, high-performance CPU PyMuPDF layout parser).
USE_MARKER_PARSER=false
